rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidTimestamp(val) {
      return val is timestamp && val <= request.time;
    }

    function isValidUser(data) {
      return data.userId is string &&
             data.displayName is string &&
             data.email is string &&
             data.coinBalance is int &&
             data.coinBalance >= 0;
    }

    function isValidOffer(data) {
      return data.title is string &&
             data.title.size() > 0 &&
             data.rewardCoins is int &&
             data.rewardCoins > 0 &&
             data.status in ['active', 'paused'];
    }

    function isValidSubmission(data) {
      return data.userId is string &&
             data.offerId is string &&
             data.offerTitle is string &&
             data.rewardCoins is int &&
             data.status in ['pending', 'approved', 'rejected'];
    }

    function isValidWithdrawal(data) {
      return data.userId is string &&
             data.amountRupees is int &&
             data.coinsDebited is int &&
             data.payoutMethod is string &&
             data.status in ['pending', 'approved', 'rejected'];
    }

    function isValidTransaction(data) {
      return data.userId is string &&
             data.type in ['earn', 'redeem', 'checkin', 'referral'] &&
             data.title is string &&
             data.coins is int &&
             data.status in ['completed', 'pending', 'rejected'];
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isAuthenticated() && (request.auth.uid == userId || request.resource.data.diff(resource.data).affectedKeys().hasAny(['coinBalance', 'dailyStreak', 'lastCheckInDate', 'lifetimeCoins'])) && isValidUser(request.resource.data);
      allow delete: if false;
    }

    match /offers/{offerId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isValidOffer(request.resource.data);
      allow delete: if isAuthenticated();
    }

    match /submissions/{submissionId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || request.auth != null);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && isValidSubmission(request.resource.data);
      allow update: if isAuthenticated() && isValidSubmission(request.resource.data);
      allow delete: if false;
    }

    match /withdrawals/{withdrawalId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || request.auth != null);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && isValidWithdrawal(request.resource.data);
      allow update: if isAuthenticated() && isValidWithdrawal(request.resource.data);
      allow delete: if false;
    }

    match /transactions/{transactionId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || request.auth != null);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && isValidTransaction(request.resource.data);
      allow update, delete: if false;
    }
  }
}
